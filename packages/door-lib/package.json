{
  "name": "door-entrance",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "npm run build -- --watch",
    "lint": "tsc --noEmit",
    "test": "npm run test:core && npm run test:package",
    "test:core": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test src/core/__tests__/*.test.ts",
    "test:package": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types --test src/__tests__/package-boundary.test.ts",
    "test:browser": "npm run build && playwright test --config tests/browser/playwright.config.ts"
  },
  "peerDependencies": {
    "@react-three/fiber": "^8.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": "^0.133.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/three": "^0.160.0",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3"
  }
}
